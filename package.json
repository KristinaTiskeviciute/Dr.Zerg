{
  "name": "dr-zerg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "vite build && wrangler dev --port 8787 --var DEV_REDIRECT:http://localhost:5173",
    "build": "npm run typecheck && vite build",
    "deploy": "npm test && npm run build && wrangler deploy",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p server",
    "types:worker": "wrangler types server/worker-configuration.d.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "partyserver": "^0.5.10"
  },
  "allowScripts": {
    "workerd@1.20261019.1": true,
    "esbuild@0.28.2": true
  }
}
