// Cloudflare Worker: serves the built game (dist/) and the multiplayer relay (one Durable Object per room).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dr-zerg",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-15",
  // Served at https://dr-zerg.dr-zerg.workers.dev. No per-version preview links.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /r/ABCD and other unknown paths serve index.html; the client reads the room code from the URL.
    "not_found_handling": "single-page-application",
    // The Worker sees every request: relay traffic goes to the room, the rest to the game files
    // (or, in local dev, a redirect to Vite).
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
